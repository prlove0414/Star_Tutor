# ============================================
# 星学伴 · API 配置
# 复制此文件为 .env，填入真实值
# .env 不提交到 Git（已在 .gitignore 中）
# ============================================

# --- DeepSeek API（教师 Agent + 评估 + Harness 裁判）---
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# --- Vision API（学生上传图片识别）---
# 支持 OpenAI 兼容接口，如 Qwen-VL、GPT-4V 等
VISION_API_KEY=your-vision-api-key
VISION_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL_NAME=qwen-vl-max

# --- Neo4j 知识图谱 ---
NEO4J_URI=neo4j+ssc://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password

# --- 本地模型路径 ---
# Docker 部署用  /app/models/Qwen3.5-4B
# 本地部署用  models/Qwen3.5-4B  或绝对路径
MODEL_PATH=models/Qwen3.5-4B

# --- 出题模式 ---
# local = 本地 GPU 推理（需要 NVIDIA 显卡，速度最快）
# api   = 远程 API 调用（无需 GPU，使用 DeepSeek API）
QUESTION_PROVIDER=local
