# 星学伴 · Docker 构建忽略
# 以下文件/目录不会被 COPY 进镜像

# Python 缓存
__pycache__
*.pyc
*.pyo
*.egg-info
.eggs

# 虚拟环境
.venv
venv

# 模型权重（通过 volume 挂载，不打包）
models/

# Git
.git
.gitignore

# 会话数据（运行时产生，不打包）
data/sessions/

# 评估/实验产物（不参与运行）
evaluation/
data/sessions/
data/irt_harness.json
data/l2_agent_harness.json
data/*_report.md

# IDE / 工具
.vscode/
.idea/
*.swp
*.swo

# 系统文件
.DS_Store
Thumbs.db

# 部署教程等不参与运行的文档（README 除外）
DEPLOY.md
明日任务.md

# 无 GPU 版 compose 文件
docker-compose.cpu.yml
